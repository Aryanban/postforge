# ── PostForge backend configuration ──
# Copy to `.env` and fill in. All keys are OPTIONAL:
# with none set the server runs in DRY_RUN mode (simulated dispatch).

# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/postforge.db

# DRY_RUN=true keeps the full pipeline running but never calls a paid API.
# Set to false once your keys are in place to dispatch for real.
DRY_RUN=true

# Encryption passphrase for stored credentials (LinkedIn tokens). Optional:
# if omitted, a key is generated and persisted to ./data/vault.key
# VAULT_ENCRYPTION_KEY=change-me

# X / Twitter API v2 (OAuth 1.0a user context — requires Basic tier to post)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Reddit (script app, password grant)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# LinkedIn (OAuth 2.0 — create an app with the w_member_social scope)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# Google Gemini (AI generation; optional — template fallback used when blank)
GEMINI_API_KEY=
