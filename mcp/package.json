{
  "name": "@postforge/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for PostForge — ingest projects, generate algorithm-scored posts, lint against shadowban risks, and dispatch.",
  "type": "module",
  "bin": {
    "postforge": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@postforge/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2"
  }
}
